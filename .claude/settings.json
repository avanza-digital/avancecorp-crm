{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx oxlint *)",
      "Bash(npx playwright *)",
      "Bash(node --check *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "mcp__codegraph",
      "mcp__context7",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__list_edge_functions",
      "mcp__claude_ai_Supabase__list_branches",
      "mcp__claude_ai_Supabase__list_migrations",
      "mcp__claude_ai_Supabase__get_advisors",
      "mcp__claude_ai_Supabase__get_organization",
      "mcp__claude_ai_Supabase__get_cost"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(dropdb *)",
      "Bash(psql *)",
      "Bash(supabase db reset *)",
      "Bash(supabase db push *)",
      "Bash(supabase functions deploy *)",
      "Bash(npx supabase db reset *)",
      "Bash(npx supabase db push *)",
      "Bash(npx supabase functions deploy *)",
      "Bash(vercel deploy *)",
      "Bash(vercel deploy)",
      "Bash(vercel --prod *)",
      "Bash(vercel --prod)",
      "Bash(vercel promote *)",
      "Bash(vercel rollback *)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "mcp__codex__codex",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__hostinger-hosting__hosting_deployStaticWebsite",
      "mcp__hostinger-hosting__hosting_clearWebsiteCacheV1"
    ],
    "deny": [
      "mcp__codex__codex-reply",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.envrc)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials)",
      "Read(//**/credentials.*)",
      "Read(//**/credentials-*)",
      "Read(//**/credentials/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Edit|MultiEdit|Write|NotebookEdit|NotebookRead)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/proteger-archivos.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/proteger-comandos.sh"
          }
        ]
      },
      {
        "matcher": "^mcp__codex__codex$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validar-codex-review.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxlint-post-edit.sh"
          }
        ]
      }
    ]
  }
}
