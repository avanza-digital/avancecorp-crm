        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "function prepararAlerta(evento, ahoraMs) {\n  if (evento?.workflow?.id !== 'OKrtxmixSxpfhVxE') return null\n  if (!Number.isFinite(ahoraMs) || ahoraMs < 0) throw new Error('Falta la hora del aviso')\n  const prueba = evento.prueba === true\n  const id = String(evento.execution?.id ?? '')\n  const ejecucion = /^\\d+$/.test(id) ? id : 'consultar historial'\n  const url = 'https://n8n-t27j.srv1906432.hstgr.cloud/workflow/OKrtxmixSxpfhVxE'\n  return {\n    clave: 'OKrtxmixSxpfhVxE|' + (prueba ? 'prueba|' : 'error|') + Math.floor(ahoraMs / 3600000),\n    workflow: 'OKrtxmixSxpfhVxE',\n    asunto: '[PRUEBA F3] ' + 'Avance Corp — Revisar importación Formulario 3',\n    mensaje: prueba\n      ? 'Este es un aviso de prueba de Formulario 3. El canal de correo funciona.\\n\\nFlujo: ' + url\n      : 'PRUEBA AISLADA: se provocó un fallo controlado en la importación de Formulario 3.\\nEjecución: ' + ejecucion + '\\n\\nRevisa la ejecución en n8n para identificar los pendientes y corregir el problema:\\n' + url + '\\n\\nSe envía como máximo un aviso por hora mientras persistan los errores.',\n  }\n}\nreturn $input.all().map((item,i)=>({json:prepararAlerta(item.json,Date.now()),pairedItem:{item:i}})).filter(item=>item.json!==null);"
        }
