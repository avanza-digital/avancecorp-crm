<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>Revisión G6 · Avance Corp</title>
<style>
:root{color-scheme:light;font-family:Arial,Helvetica,sans-serif;color:#17243d;background:#f3f5f9;font-synthesis:none}
*{box-sizing:border-box}body{margin:0}header{background:#111e3d;color:#fff;padding:24px max(24px,calc((100% - 1160px)/2))}
.marca{font-size:13px;font-weight:700;letter-spacing:.12em}.submarca{font-size:13px;color:#b8c7e3;margin-top:7px}
main{max-width:1208px;margin:auto;padding:36px 24px 60px}h1{font-size:34px;line-height:1.15;margin:14px 0;color:#111e3d}h2{font-size:21px;margin:0 0 12px}h3{font-size:16px;margin:0 0 12px}
p{font-size:15px;line-height:1.6;margin:8px 0}.muted{color:#56657c}.etiqueta{display:inline-block;background:#e7efff;color:#174bba;font-size:12px;font-weight:700;padding:7px 10px;border-radius:5px}
.estado{background:#fff4da;color:#76500b}.resumen{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:25px 0;margin:14px 0 24px;border-top:1px solid #dae1ec;border-bottom:1px solid #dae1ec}.numero{font-size:30px;font-weight:700;line-height:1.3}.leyenda{font-size:13px;color:#56657c;margin-top:5px}
section{background:#fff;border:1px solid #dbe2ed;border-radius:10px;padding:24px;margin-top:20px}.cabecera{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:18px;flex-wrap:wrap}
label{font-size:13px;font-weight:700;display:block;margin-bottom:6px}select{font:inherit;color:#17243d;border:1px solid #b7c4d7;border-radius:6px;padding:10px 36px 10px 12px;background:#fff;min-width:210px}
button:focus-visible,select:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid #2563eb;outline-offset:3px}.tabla{overflow:auto;border:1px solid #e0e6ef;border-radius:6px}table{border-collapse:collapse;width:100%;font-size:14px;white-space:nowrap}th{background:#f4f7fb;text-align:left;font-size:12px;color:#42516a;font-weight:700}th,td{padding:13px 15px;border-bottom:1px solid #e6ebf2}tbody tr:last-child td{border-bottom:0}td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}.bien{color:#174bba;font-weight:700}.aviso{color:#8a5700;font-weight:700}.nota{font-size:13px;color:#56657c;margin-top:13px;line-height:1.55}.rejilla{display:grid;grid-template-columns:1fr 1fr;gap:20px}.compacta{margin-top:0}.lista{padding-left:22px;line-height:1.7;font-size:15px}.lista li{padding:3px 0}
details{margin-top:16px;border-top:1px solid #e0e6ef;padding-top:16px}summary{cursor:pointer;font-size:15px;font-weight:700;line-height:1.5;color:#174bba;padding:5px 0}details .tabla{margin-top:15px}.scroll{max-height:470px}code{font-size:11px;overflow-wrap:anywhere;white-space:normal}.privado{margin-top:24px;color:#56657c;font-size:12px;line-height:1.6}.leyenda-periodo{font-size:13px;color:#56657c}.celda-nombre{white-space:normal;min-width:150px;max-width:280px}
@media(max-width:720px){main{padding:24px 14px 40px}header{padding:20px 16px}h1{font-size:28px}section{padding:18px 14px}.resumen{grid-template-columns:1fr 1fr;gap:22px}.rejilla{grid-template-columns:1fr}select{width:100%;min-width:0}.cabecera>div{width:100%}th,td{padding:11px 12px}h2{font-size:19px}.numero{font-size:27px}}
@media print{body{background:#fff}header{background:#fff;color:#111e3d;padding:0}.submarca{color:#56657c}main{padding:20px 0;max-width:none}section{break-inside:avoid}.resumen{margin-bottom:12px}.tabla,.scroll{overflow:visible;max-height:none}details{display:none}.privado{font-size:10px}}
</style>
</head>
<body>
<header><div class="marca">AVANCE CORP</div><div class="submarca">Plan multiempresa · Conciliación G6</div></header>
<main>
<span class="etiqueta estado">Pendiente de conformidad humana</span>
<h1>Comparación lista para revisar</h1>
<p>Capital, conversiones y responsables contrastados con los datos reales del CRM.</p>
<p class="muted" id="corte"></p>
<div class="resumen">
 <div><div class="numero" id="n-operaciones"></div><div class="leyenda">inversiones comprobadas</div></div>
 <div><div class="numero">0</div><div class="leyenda">diferencias de capital</div></div>
 <div><div class="numero">0</div><div class="leyenda">inversiones duplicadas</div></div>
 <div><div class="numero aviso" id="n-pendientes"></div><div class="leyenda">registros con identidad pendiente</div></div>
</div>
<section>
 <div class="cabecera"><div><h2>Capital por empresa y moneda</h2><div id="periodo-nota" class="leyenda-periodo"></div></div>
 <div><label for="mes">Periodo que quieres revisar</label><select id="mes"></select></div></div>
 <div class="tabla"><table><thead><tr><th>Empresa</th><th>Moneda</th><th class="num">CRM actual</th><th class="num">Informe F7</th><th class="num">Diferencia</th><th class="num">Inversiones CRM / F7</th></tr></thead><tbody id="capital"></tbody></table></div>
 <p class="nota">Es el capital de las inversiones del periodo, incluyendo el capital completo de renovaciones y upgrades. No representa únicamente dinero nuevo. PEN y USD se mantienen separados.</p>
 <details><summary>Ver contratos nuevos, renovaciones y upgrades</summary><div class="tabla"><table><thead><tr><th>Empresa</th><th>Tipo</th><th>Moneda</th><th class="num">Inversiones</th><th class="num">Capital</th></tr></thead><tbody id="tipos"></tbody></table></div></details>
</section>
<section>
 <h2>Conversión comercial</h2>
 <div class="tabla"><table><thead><tr><th>Indicador</th><th class="num">Reporte oficial</th><th class="num">Informe F7</th><th>Resultado</th></tr></thead><tbody id="conversion"></tbody></table></div>
 <p class="nota" id="conversion-nota"></p>
 <p class="nota">La conversión aplica las reglas y ponderaciones vigentes; su numerador no es la cantidad de inversiones. Las comisiones se calculan fuera del CRM.</p>
</section>
<section>
 <h2>Atribución por responsable</h2><p id="atribucion-nota" class="muted"></p>
 <p id="cobertura-capital" class="nota"></p>
 <details><summary>Ver inversiones fuera del ranking del mes</summary><p class="nota" id="fuera-roster-total"></p><div class="tabla"><table><thead><tr><th>Referencia</th><th>Empresa</th><th>Responsable</th><th class="num">Capital incluido</th></tr></thead><tbody id="fuera-roster"></tbody></table></div></details>
 <details><summary>Ver capital por analista</summary><div class="tabla scroll"><table><thead><tr><th>Analista</th><th>Empresa</th><th>Moneda</th><th class="num">Inversiones</th><th class="num">Capital</th></tr></thead><tbody id="atribucion"></tbody></table></div></details>
 <details><summary>Ver cada inversión comprobada</summary><div class="tabla scroll"><table><thead><tr><th>Referencia</th><th>Fecha</th><th>Empresa</th><th class="num">Capital</th><th>Analista</th><th>Identidad</th></tr></thead><tbody id="operaciones"></tbody></table></div></details>
</section>
<section>
 <h2>Cobertura de personas e identidades</h2><p id="personas-nota"></p>
 <p id="relaciones-nota" class="nota"></p>
 <details><summary id="pendientes-titulo"></summary><p class="nota">La lista abarca toda la historia conocida, mientras que la tabla de capital muestra el mes elegido. Los importes del mes están incluidos en su capital. Los titulares pendientes no cuentan dentro de las personas identificadas; no se vinculó ni modificó ningún registro.</p>
 <div class="tabla"><table><thead><tr><th>Referencia</th><th>Cliente registrado</th><th>Empresa</th><th>Fecha</th><th class="num">Capital</th></tr></thead><tbody id="pendientes"></tbody></table></div></details>
 <p class="nota" id="cobertura-real"></p>
</section>
<div class="rejilla">
 <section><h2>Vencimientos próximos</h2><p class="nota">Ventana de 30 días desde el corte, inclusive. Capital contractual de inversiones vigentes.</p><div class="tabla"><table><thead><tr><th>Empresa</th><th class="num">Inversiones</th><th class="num">Capital</th></tr></thead><tbody id="vencimientos"></tbody></table></div></section>
 <section><h2>Oportunidades por empresa</h2><p class="nota">Personas con inversión conocida en otra empresa. Es una señal para evaluación comercial.</p><div class="tabla"><table><thead><tr><th>Empresa destino</th><th class="num">Personas</th></tr></thead><tbody id="oportunidades"></tbody></table></div></section>
</div>
<section>
 <h2>Qué falta para cerrar G6</h2>
 <ol class="lista"><li>Revisar estos importes y conversiones con Miguel y el responsable financiero.</li><li>Dejar constancia de la conformidad con este corte y sus límites de cobertura.</li><li>Registrar la aprobación en el acta G6 antes de solicitar el piloto F8.</li></ol>
 <p id="claude" class="nota"></p>
 <p class="nota">La comprobación técnica pasó. Esta página no registra una firma ni una aprobación y no activa funciones del CRM.</p>
</section>
<footer class="privado"><strong>Comparativo privado · Solo lectura · F7 apagada.</strong><br>
Se evaluó la proyección de consulta de F7 instalada y se contrastó con sus fuentes y reportes oficiales. La RPC pública de cifras permanece apagada. La foto sellada de agosto conserva sus huellas.<br>
Archivo autónomo, sin conexión a servicios externos. Identificador de la captura: <code id="huella"></code></footer>
</main>
<script type="application/json" id="datos">__DATOS_G6__</script>
<script>
'use strict';
const d=JSON.parse(document.getElementById('datos').textContent);
const nombres={avance:'Avance Corp',qorilazo:'Qorilazo',prodelco:'Prodelco'};
const tipos={contrato_nuevo:'Contrato nuevo',contrato_renovacion:'Renovación',contrato_upgrade:'Upgrade',cooperativa:'Cooperativa'};
const esc=x=>String(x??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=(x,n=2)=>Number(x).toLocaleString('es-PE',{minimumFractionDigits:n,maximumFractionDigits:n});
const dinero=(v,m)=>`${m==='USD'?'US$':'S/'} ${num(v)}`;
const fecha=s=>s.slice(0,10).split('-').reverse().join('/');
const mesNombre=s=>new Intl.DateTimeFormat('es-PE',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(s+'T12:00:00Z'));
const celda=(x,clase='')=>`<td${clase?' class="'+clase+'"':''}>${esc(x)}</td>`;
const tabla=(id,filas)=>{document.getElementById(id).innerHTML=filas.map(f=>'<tr>'+f+'</tr>').join('')};
document.getElementById('corte').textContent='Corte: '+new Intl.DateTimeFormat('es-PE',{dateStyle:'long',timeStyle:'short',timeZone:'America/Lima'}).format(new Date(d.captura))+' · Lima. Las cifras corresponden a esa captura.';
document.getElementById('n-operaciones').textContent=d.verificacion.verificaciones.reduce((s,m)=>s+m.operaciones,0);
document.getElementById('n-pendientes').textContent=d.pendientes.length;
document.getElementById('huella').textContent=d.sha256;
document.getElementById('claude').textContent=d.revision;
const selector=document.getElementById('mes');
for(const m of [...d.meses].reverse()){const o=document.createElement('option');o.value=m.mes;o.textContent=mesNombre(m.mes)+(m.sellado?' · cerrado':' · al '+fecha(m.hasta));selector.append(o)}
function mostrar(){
 const m=d.meses.find(x=>x.mes===selector.value);
 document.getElementById('periodo-nota').textContent=m.sellado?'Mes cerrado. El capital es una consulta actual; la conversión se contrasta también con la foto sellada.':'Mes en curso: desde '+fecha(m.mes)+' hasta '+fecha(m.hasta)+'.';
 tabla('capital',m.capital.map(f=>celda(nombres[f.empresa])+celda(f.moneda)+celda(dinero(f.capital_nucleo,f.moneda),'num')+celda(dinero(f.capital_informe,f.moneda),'num')+celda(dinero(f.diferencia_capital,f.moneda),'num bien')+celda(f.operaciones_nucleo+' / '+f.operaciones_informe,'num')));
 tabla('tipos',m.tipos.map(f=>celda(nombres[f.empresa])+celda(tipos[f.tipo_capital]||f.tipo_capital)+celda(f.moneda)+celda(f.operaciones,'num')+celda(dinero(f.capital,f.moneda),'num')));
 const f=m.conversion,c=m.conversionOficial;
 tabla('conversion',[
   ['Llegadas que forman el divisor',num(c.divisor,0),num(f.divisor,0)],
   ['Numerador ponderado',num(c.numerador),num(f.numerador)],
   ['Tasa de conversión',c.conversion_pct==null?'Sin divisor':num(c.conversion_pct)+' %',f.tasa_pct==null?'Sin divisor':num(f.tasa_pct)+' %']
 ].map(x=>celda(x[0])+celda(x[1],'num')+celda(x[2],'num')+celda('Coincide','bien')));
 document.getElementById('conversion-nota').textContent='Factor vigente para referidos y renovaciones: '+num(f.factor_referido)+'. '+(m.sellado?'La conversión coincide con el reporte oficial cerrado de agosto.':'La conversión coincide con el reporte oficial del mes en curso.');
 document.getElementById('atribucion-nota').textContent=m.cobertura.operaciones+' inversiones comparadas por fuente y analista. '+m.cobertura.fuera_roster+' operaciones pertenecen a responsables fuera del ranking del mes y están incluidas en el capital.';
 document.getElementById('cobertura-capital').textContent='Sin analista: '+m.cobertura.sin_analista+'. Con anulación comercial: '+m.cobertura.anulaciones_comerciales+'. Una anulación comercial no elimina automáticamente el capital contractual.';
 const fuera=m.operaciones.filter(o=>!o.en_roster);
 document.getElementById('fuera-roster-total').textContent=fuera.length?Object.keys(nombres).flatMap(empresa=>['PEN','USD'].flatMap(moneda=>{const grupo=fuera.filter(o=>o.empresa===empresa&&o.moneda===moneda);return grupo.length?[nombres[empresa]+': '+dinero(grupo.reduce((s,o)=>s+o.capital,0),moneda)]:[]})).join(' · '):'No hay inversiones fuera del ranking en este periodo.';
 tabla('fuera-roster',fuera.map(o=>celda(o.referencia)+celda(nombres[o.empresa])+celda(o.analista||'Sin analista','celda-nombre')+celda(dinero(o.capital,o.moneda),'num')));
 tabla('atribucion',m.atribucion.map(a=>celda(a.analista_nombre||'Sin analista','celda-nombre')+celda(nombres[a.empresa])+celda(a.moneda)+celda(a.operaciones,'num')+celda(dinero(a.capital,a.moneda),'num')));
 tabla('operaciones',m.operaciones.map(o=>celda(o.referencia)+celda(fecha(o.fecha))+celda(nombres[o.empresa])+celda(dinero(o.capital,o.moneda),'num')+celda(o.analista||'Sin analista','celda-nombre')+celda(o.identidad_estado==='coherente'?'Identificada':'Pendiente',o.identidad_estado==='coherente'?'':'aviso')));
}
selector.addEventListener('change',mostrar);mostrar();
const p=d.personas;
document.getElementById('personas-nota').textContent=p.total+' personas identificadas en la historia conocida: '+p.por_empresa.map(x=>x.personas+' en '+nombres[x.empresa]).join(', ')+'. '+p.fuentes_coherentes+' fuentes tienen identidad coherente y '+p.fuentes_sin_identidad+' están pendientes. Los titulares sin identidad resuelta no están incluidos en esas '+p.total+' personas.';
document.getElementById('relaciones-nota').textContent=p.fuentes_sin_relacion+' fuentes conservan el registro anterior de inversiones, sin una fila relacional F4. F7 las incluye en su lectura. Esta revisión no trasladó ni corrigió datos.';
document.getElementById('pendientes-titulo').textContent='Ver los '+d.pendientes.length+' registros con identidad pendiente';
tabla('pendientes',d.pendientes.map(x=>celda(x.referencia)+celda(x.nombre,'celda-nombre')+celda(nombres[x.empresa])+celda(fecha(x.fecha))+celda(dinero(x.capital,x.moneda),'num')));
document.getElementById('cobertura-real').textContent='En este corte hay '+p.filas_cotitulares+' cotitulares, '+(p.dos_empresas+p.tres_empresas)+' personas registradas en varias empresas y '+p.personas_con_veto+' personas con veto de contacto. Esos casos no se han podido ejercitar con datos reales aquí; las pruebas anteriores usaron ejemplos ficticios.';
tabla('vencimientos',d.vencimientos.map(x=>celda(nombres[x.empresa])+celda(x.operaciones,'num')+celda(dinero(x.capital,x.moneda),'num')));
tabla('oportunidades',d.oportunidades.map(x=>celda(nombres[x.empresa])+celda(x.personas,'num')));
</script>
</body>
</html>
