{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/exhaustive-deps": "warn",

    // jsx-a11y: las reglas funcionales del plugin quedan activas. Las CINCO
    // siguientes se apagan por FALSOS POSITIVOS de patrón (no por comodidad).
    // (Decía "cuatro" y listaba cinco desde que se añadió la del combobox: una
    // revisión que confíe en el comentario cuenta mal las puertas abiertas.)
    // - prefer-tag-over-role: cards ricas con role=button + tabIndex +
    //   onKeyDown (ya operables por teclado), svg con role=img y el combobox
    //   WAI-ARIA del buscador no pueden ser <button>/<img>/<select> reales.
    //   CUARTA puerta, registrada 2026-08-14 al auditarla (llevaba abierta sin
    //   apuntar): los card-stack de móvil usan role=list/listitem sobre <div>.
    //   Aquí el rol explícito es MÁS robusto que un <ul> real — el preflight de
    //   Tailwind pone list-style:none y Safari+VoiceOver borra la semántica de
    //   lista en ese caso. Se apunta para que la próxima revisión no cuente mal
    //   las puertas, no para abrir ninguna nueva.
    "jsx-a11y/prefer-tag-over-role": "allow",
    // - wrappers genéricos (DialogTitle, Label) reciben children vía
    //   {...props}; el contenido existe en cada punto de uso.
    "jsx-a11y/heading-has-content": "allow",
    "jsx-a11y/label-has-associated-control": "allow",
    // - autoFocus SOLO se usa dentro de diálogos modales (patrón aceptado:
    //   el foco debe entrar al modal al abrirse).
    "jsx-a11y/no-autofocus": "allow",
    // - el buscador del topbar implementa el patrón combobox WAI-ARIA
    //   (ul[role=listbox] / li[role=option]) — es el rol correcto.
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "allow"
  }
}
