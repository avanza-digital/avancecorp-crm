VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo funciona con `npm run dev`; los builds de producción lo ignoran aunque sea true.
VITE_ENABLE_DEMO=false

# Observabilidad remota OPCIONAL (Sentry). Vacío = todo queda en la consola
# local y el chunk de Sentry ni se descarga. Pegar aquí el DSN del proyecto
# Sentry para activarla; el scrub de PII propio se aplica antes de enviar.
VITE_SENTRY_DSN=
