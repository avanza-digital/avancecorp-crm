{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && env CRM_BUILD_ID=f41-preview-20260825 VITE_ENABLE_DEMO=true VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= VITE_SENTRY_DSN= vite build --mode preview",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:bundle": "node scripts/verificar-bundle-produccion.mjs",
    "dup": "jscpd src --min-tokens 70 --ignore \"**/*.test.*\" --threshold 0.8 --reporters consoleFull",
    "prepare": "lefthook install",
    "typecheck": "tsc -b --pretty false",
    "gen:types": "npx supabase@2.114.0 gen types typescript --project-id dctqcbznekcyxhjujuci --schema public,crm > src/lib/database.types.ts.tmp && mv src/lib/database.types.ts.tmp src/lib/database.types.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run verify:bundle && npm run dup",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "valibot": "^1.4.2",
    "xstate": "^5.32.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jscpd": "^5.0.12",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "oxlint": "^1.71.0",
    "pdfmake": "^0.2.20",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
