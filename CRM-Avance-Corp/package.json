{
  "name": "avancecorp-crm-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:scripts": "node --check supabase/scripts/fixtures.mjs && node --check supabase/scripts/seed-demo.mjs && node --check supabase/scripts/test-rls.mjs",
    "seed:demo": "node supabase/scripts/seed-demo.mjs",
    "seed:preflight": "node supabase/scripts/seed-demo.mjs --preflight",
    "test:edge-preflight": "node --test ../_supabase_functions/functions/_shared/bancarios.test.mjs ../_supabase_functions/functions/crm-convertir-lead/preflight.test.mjs",
    "test:rls": "node supabase/scripts/test-rls.mjs",
    "test:rls:preflight": "node supabase/scripts/test-rls.mjs --preflight",
    "release:crm": "npm --prefix app run build && node scripts/crear-artefacto-release.mjs create",
    "release:crm:verify": "node scripts/crear-artefacto-release.mjs verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.2"
  }
}
