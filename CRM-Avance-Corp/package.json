    "test:edge-preflight": "node --test ../_supabase_functions/functions/crm-inversion-portal/handler.test.mjs ../_supabase_functions/functions/_shared/bancarios.test.mjs ../_supabase_functions/functions/_shared/domicilio.test.mjs ../_supabase_functions/functions/crm-convertir-lead/acceso.test.mjs ../_supabase_functions/functions/crm-convertir-lead/preflight.test.mjs ../_supabase_functions/functions/crm-convertir-lead/domicilio-atomico.test.mjs ../_supabase_functions/functions/crear-cliente/autorizacion.test.mjs && deno check --node-modules-dir=auto --frozen ../_supabase_functions/functions/crm-convertir-lead/index.ts ../_supabase_functions/functions/crear-cliente/index.ts supabase/functions/crm-tipo-cambio/index.ts supabase/functions/crm-tipo-cambio/handler.ts && deno test --node-modules-dir=auto --frozen supabase/functions/crm-tipo-cambio/handler.test.ts",
