    "test:mutantes": "node scripts/mutantes-puente.mjs",
    "test:rls": "node supabase/scripts/test-rls.mjs",
    "test:rls:preflight": "node supabase/scripts/test-rls.mjs --preflight",
    "test:ficha-360:db": "bash supabase/scripts/run-test-ficha-360-local.sh --run",
    "test:ficha-360:db:preflight": "bash supabase/scripts/run-test-ficha-360-local.sh --preflight",
    "gate:config": "node supabase/scripts/gate-config-operativa.mjs",
    "gate:config:preflight": "node supabase/scripts/gate-config-operativa.mjs --preflight",
