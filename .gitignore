# .gitignore — qué NUNCA debe versionar git en este repo.
# Protege secretos y mantiene fuera los directorios pesados/sensibles.

# --- SO / temporales ---
.DS_Store
~$*

# --- Secretos / entorno (NUNCA versionar) ---
.env
*.env
.env.*
*.pem
*.key
*.p12
credentials*.json
service_role*

# --- Archivos y respaldos pesados ---
*.zip
*.pptx
DEPLOY-*/
_ARCHIVO_VIEJO/
_backups/
_dev_backup/
_dev_artifacts/
_DEV_NO_SUBIR/
_no-subir-a-hostinger/

# --- Dependencias ---
# Sin barra final A PROPOSITO: con `node_modules/` git solo ignora DIRECTORIOS,
# y el symlink `node_modules` que lleva cada worktree es un blob -> se colaba
# al commit (paso el 20/09/2026 en la rama de Gestion Diaria F3).
node_modules
**/node_modules

# --- Índices y artefactos locales de herramientas (reconstruibles; no versionar) ---
.codegraph/
.codex/
output/
tmp/
/supabase/.temp/
/_supabase_functions/.temp/

# Superpowers brainstorming (mockups locales)
.superpowers/

# --- Artefactos de sesiones de browser-automation (capturas/dumps efímeros) ---
.playwright-mcp/
.hermes/

# Datos comerciales de Miguel: proyecciones por analista. No van al historial.
CRM-Avance-Corp/PROYECCION DE VENTAS*.xlsx

# Carpeta de lectura de Miguel (su LEEME: «no está en git»); la copia con seguimiento
# vive en CRM-Avance-Corp/docs/gestion-diaria/.
CRM-Avance-Corp/GESTION DIARIA/
